{
  "name": "pyramid-builders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "khufu:sim": "node scripts/khufu-sim.mjs",
    "khufu:check": "node scripts/khufu-sim-check.mjs",
    "khufu:seek": "node scripts/khufu-seek.mjs",
    "khufu:gangs": "node scripts/khufu-gangs.mjs",
    "khufu:works": "node scripts/khufu-works.mjs",
    "khufu:theories": "node scripts/khufu-theories.mjs",
    "test": "npm run test:unit && npm run test:model && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:model": "npm run khufu:check && npm run khufu:seek && npm run khufu:gangs && npm run khufu:works && npm run khufu:theories",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "vite": "5.4.11"
  }
}
